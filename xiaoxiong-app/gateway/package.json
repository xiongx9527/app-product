{
  "name": "app-product-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地 AgentScope TS 网关：WebSocket 语音 + REST 数据 + Swagger（契约见 ../contracts）",
  "scripts": {
    "dev": "tsx watch src/embedded/entry.ts",
    "start": "tsx src/embedded/entry.ts",
    "dev:bg": "node ../scripts/dev-server.mjs start",
    "dev:stop": "node ../scripts/dev-server.mjs stop",
    "dev:restart": "node ../scripts/dev-server.mjs restart",
    "dev:status": "node ../scripts/dev-server.mjs status",
    "dev:log": "node ../scripts/dev-server.mjs log",
    "build:bundle": "esbuild src/embedded/entry.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/gateway.bundle.mjs --external:swagger-ui-dist \"--banner:js=import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentscope-ai/agentscope": "^0.0.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "swagger-ui-dist": "^5.34.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
