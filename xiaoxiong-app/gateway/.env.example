# 网关运行环境变量示例。复制为 .env 后按需填写，.env 已被 git 忽略。
# 启动：cp .env.example .env && npm start

# ── 监听 ──────────────────────────────────────────────
PORT=8787
API_BASE=/api
WS_PATH=/ws

# ── 前后端参数加解密（REST 请求/响应加解密，默认关闭）──
PARAM_ENCRYPT=false
RSA_BACKEND_PRIVATE_KEY=
RSA_FRONTEND_PUBLIC_KEY=

# ── 时间工具：默认东八区，客户端可在设置页覆盖 ────────
TIME_ZONE=Asia/Shanghai

# ── 天地图逆地理编码（位置工具「我在哪」用）──────────
# 留空则不启用，位置工具退回客户端自带地址。
# 必填服务端类型应用的 tk（控制台创建应用时选「服务端」，
# 用浏览器端 tk 会被 Referer/UA 校验拦掉）。个人开发者日配额 7000 次。
TIANDITU_TK=

# ── LLM ──────────────────────────────────────────────
# stub=离线测试（返回「离线回包」占位，仅 CI/无 LLM 环境用，正式联调不要开）；
# 真实厂商：ollama / openai / dashscope / deepseek。
# 本机联调走 Ollama 原生 /api/chat（provider=ollama）。Ollama 仅绑 127.0.0.1，
# 需先建 SSH 隧道把本机 11434 转过去：-L 127.0.0.1:11434:127.0.0.1:11434 192.168.1.100
# 因此 baseUrl 必须用 127.0.0.1:11434（绝不能写 192.168.1.100:11434，那个地址连不通）。
# gpt-oss:120b-cloud 是 Ollama cloud 模型，需 ollama 已登录（ollama login）。
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gpt-oss:120b-cloud
LLM_API_KEY=
# JSON 字符串，透传厂商级参数（如 temperature / top_p 等）
LLM_PARAMS=

# ── ASR ──────────────────────────────────────────────
# stub=离线测试；whisper/azure/aliyun/xunfei=真实厂商
# 语音唤醒必须走真实 ASR（stub 只回固定占位文字，永远匹配不上唤醒词）
ASR_PROVIDER=whisper
ASR_BASE_URL=http://192.168.1.100:9529
ASR_API_KEY=
# 句末静音判定（毫秒）
ASR_ENDPOINT_MS=700
# JSON 字符串，如 {"language":"zh","sampleRate":16000}
ASR_PARAMS={"language":"zh","sampleRate":16000}

# ── TTS ──────────────────────────────────────────────
# stub=离线测试；edge/azure/aliyun/xunfei=真实厂商
TTS_PROVIDER=edge
TTS_BASE_URL=http://192.168.1.100:9529
TTS_API_KEY=
# JSON 字符串，如 {"voice":"zh-CN-XiaoxiaoNeural"}
TTS_PARAMS={"voice":"zh-CN-XiaoxiaoNeural"}

# ── 数据库（Node 端 SQLite，参数化查询）──────────────
DB_PATH=./data/app.db
# 落库加密密钥（RSA PEM）：加密 device_data 中的 api-key 等敏感字段
DB_PUBLIC_KEY=
DB_PRIVATE_KEY=
