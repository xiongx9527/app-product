# 网关运行环境变量示例。复制为 .env 后按需填写，.env 已被 git 忽略。
# 启动：cp .env.example .env && npm start

# ── 监听 ──────────────────────────────────────────────
PORT=8787
API_BASE=/api
WS_PATH=/ws

# ── 前后端参数加解密（REST 请求/响应加解密，默认关闭）──
PARAM_ENCRYPT=false
RSA_BACKEND_PRIVATE_KEY=
RSA_FRONTEND_PUBLIC_KEY=

# ── 时间工具：默认东八区，客户端可在设置页覆盖 ────────
TIME_ZONE=Asia/Shanghai

# ── 本地 AI 服务（scripts/services.sh / voice.sh）──────────────
# 一个进程同时提供：
#   /llm/v1  LLM（OpenAI 兼容纯转发代理，上游在 voice.conf 配）
#   /voice   STT / TTS（OpenAI 兼容音频接口）
# 默认监听 0.0.0.0:9529；三个 BASE_URL 都指向它。

# ── LLM ──────────────────────────────────────────────
# stub=离线测试（返回「离线回包」占位，仅 CI/无 LLM 环境用，正式联调不要开）；
# 真实厂商：openai / ollama / dashscope / deepseek。
# 本地 AI 服务的 /llm/v1 是纯转发代理：用 openai 协议接入，由它把请求原样
# 转发到 voice.conf 的 LLM_UPSTREAM_BASE_URL（任意 OpenAI 兼容上游，云端 API
# 或本机 Ollama 的 /v1 均可）。
# provider=ollama 走 Ollama 原生 /api/chat，需把 LLM_BASE_URL 直接指向 Ollama
# （http://127.0.0.1:11434），不再经本地 AI 服务转发。
# 模型名：默认按上游填（下面是 Ollama cloud 模型，需 ollama login）。
# 注意：本地 AI 服务若开启 LLM_UPSTREAM_POOL（多地址/账号池，见 voice.conf），
# 每个入口自带 model 字段，会覆盖此处的值，因此这里只是“逻辑名”，真实模型名由
# 池里每个上游入口决定。换上游厂商只改 voice.conf 的池，本文件不用动。
LLM_PROVIDER=openai
LLM_BASE_URL=http://127.0.0.1:9529/llm/v1
LLM_MODEL=gpt-oss:120b-cloud
LLM_API_KEY=
# JSON 字符串，透传厂商级参数（如 temperature / top_p 等）
LLM_PARAMS=

# ── ASR ──────────────────────────────────────────────
# stub=离线测试；whisper/azure/aliyun/xunfei=真实厂商
# 语音唤醒必须走真实 ASR（stub 只回固定占位文字，永远匹配不上唤醒词）
ASR_PROVIDER=whisper
ASR_BASE_URL=http://127.0.0.1:9529/voice
ASR_API_KEY=
# 句末静音判定（毫秒）：停顿超过该值才把一句话定稿。给自然思考留余地，太短会被切断（用户反馈"只识别前一段"）。
# 之前误设为 700 导致一停顿就断，现改为 2500。代码默认同为 2500，改这里即可覆盖。
ASR_ENDPOINT_MS=2500
# JSON 字符串，如 {"language":"zh","sampleRate":16000}
ASR_PARAMS={"language":"zh","sampleRate":16000}

# ── TTS ──────────────────────────────────────────────
# stub=离线测试；edge/azure/aliyun/xunfei=真实厂商
TTS_PROVIDER=edge
TTS_BASE_URL=http://127.0.0.1:9529/voice
TTS_API_KEY=
# JSON 字符串，如 {"voice":"zh-CN-XiaoxiaoNeural"}
TTS_PARAMS={"voice":"zh-CN-XiaoxiaoNeural"}

# ── 数据库（Node 端 SQLite，参数化查询）──────────────
DB_PATH=./data/app.db
# 落库加密密钥（RSA PEM）：加密 device_data 中的 api-key 等敏感字段
DB_PUBLIC_KEY=
DB_PRIVATE_KEY=
