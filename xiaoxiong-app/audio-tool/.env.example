# 提示音生成配置模板。复制为 .env 后按需要修改。
# 脚本走 9529 的 OpenAI 兼容 TTS 接口（/voice/v1/audio/speech）。

# 提供商：builtin（9529 本地 edge-tts / kokoro）、dashscope、deepseek 等，传给 9529 的 provider 字段
TTS_PROVIDER=builtin

# 9529 服务地址（含 /voice 前缀）；脚本会拼成 $VOICE_BASE_URL/v1/audio/speech
VOICE_BASE_URL=http://127.0.0.1:9529/voice

# API key：9529 开了鉴权时用于 Authorization: Bearer；本机默认未开，留空即可
TTS_API_KEY=

# 模型：builtin 下可选 edge-tts / kokoro；上游模式填对应模型名，传给 9529 的 model 字段
TTS_MODEL=edge-tts

# 音色：与网关 edge 厂商默认一致（zh-CN-XiaoxiaoNeural）；kokoro 模型需换 kokoro 音色
TTS_VOICE=zh-CN-XiaoxiaoNeural
